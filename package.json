{
    "name": "glspinner",
    "version": "1.0.0",
    "description": "SpinnerEddy's tool made for practicing WebGL",
    "main": "dist/spinnergl-lib.cjs.js",
    "directories": {
        "test": "tests"
    },
    "module": "dist/spinnergl-lib.es.js",
    "types": "dist/spinnergl-lib.d.ts",
    "exports": {
        ".": {
            "types": "./dist/spinnergl-lib.d.ts",
            "import": "./dist/spinnergl-lib.es.js",
            "require": "./dist/spinnergl-lib.cjs.js"
        },
        "./tools": {
            "types": "./dist/spinnergl-lib.tools.d.ts",
            "import": "./dist/spinnergl-lib.tools.es.js",
            "require": "./dist/spinnergl-lib.tools.cjs.js"
        }
    },
    "scripts": {
        "dev": "vite",
        "dev:lib": "vite --config src/libs/vite.config.ts",
        "build": "tsc && vite build && vite build --config vite.tools.config.ts",
        "build:types": "rollup -c rollup.dts.config.js",
        "prepare": "npm run build && npm run build:types",
        "preview": "vite preview",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SpinnerEddy/glspinner.git"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/SpinnerEddy/glspinner/issues"
    },
    "homepage": "https://github.com/SpinnerEddy/glspinner#readme",
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/jest": "^29.5.14",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^29.7.0",
        "jszip": "^3.10.1",
        "lil-gui": "^0.20.0",
        "prettier": "^3.9.5",
        "rollup-plugin-dts": "^6.2.3",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.64.0",
        "vite": "^6.2.1",
        "vite-plugin-glsl": "^1.3.3"
    },
    "dependencies": {
        "@anthropic-ai/claude-code": "^2.1.215"
    },
    "peerDependencies": {
        "jszip": "^3.10.1",
        "lil-gui": "^0.20.0"
    },
    "peerDependenciesMeta": {
        "jszip": {
            "optional": true
        },
        "lil-gui": {
            "optional": true
        }
    }
}
