# notion.so/my-integrations で作成したInternal Integrationのトークン
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 対象3DBのdatabase_id（Notionのページ/DB URLに含まれるUUID。
# 例: https://www.notion.so/xxxx/1234567890abcdef1234567890abcdef?v=... の
#     1234567890abcdef1234567890abcdef の部分）
# 事前にこれらのDBをNOTION_TOKENのIntegrationと共有しておくこと
NOTION_DB_TASKS=00000000000000000000000000000000
NOTION_DB_RETRO=00000000000000000000000000000000
NOTION_DB_ISSUES=00000000000000000000000000000000

# glspinner本体のdev server（リポジトリルートで npm run dev、既定ポート2222）のURL
VITE_GLSPINNER_PREVIEW_URL=http://127.0.0.1:2222/
